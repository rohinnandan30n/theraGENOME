# TheraGENOME Environment Configuration

# ============================================================================
# JWT Authentication Configuration
# ============================================================================

# JWT Secret Key (generate: openssl rand -hex 32)
# PRODUCTION: Use a strong, random 32-byte hex string
JWT_SECRET_KEY=dev-secret-key-change-in-production-openssl-rand-hex-32

# JWT Algorithm (HS256 for hackathon, upgrade to RS256 for production)
JWT_ALGORITHM=HS256

# JWT Access Token Expiry (in minutes)
JWT_EXPIRY_MINUTES=60

# JWT Refresh Token Expiry (in days)
JWT_REFRESH_EXPIRY_DAYS=7

# Internal Service Key (generate: openssl rand -hex 32)
INTERNAL_SERVICE_KEY=dev-internal-key-change-in-production-openssl-rand-hex-32

# ============================================================================
# Database Configuration
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=genomic_db
DB_USER=postgres
DB_PASSWORD=password

# ============================================================================
# Kafka Configuration
# ============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW_VARIANTS=raw_variants

# ============================================================================
# Storage Configuration
# ============================================================================
STORAGE_PATH=./uploads
MAX_FILE_SIZE=5242880

# ============================================================================
# Application Configuration
# ============================================================================
APP_HOST=0.0.0.0
APP_PORT=8000

# ============================================================================
# API Gateway Configuration
# ============================================================================
API_GATEWAY_TYPE=kong
API_GATEWAY_HOST=localhost
API_GATEWAY_PORT=8000
API_GATEWAY_ADMIN_PORT=8001

# ============================================================================
# Microservice Ports
# ============================================================================
DEV1_PORT=8001
DEV2_PORT=8002
DEV3_PORT=8003
DEV4_PORT=8004

# ============================================================================
# Security Configuration
# ============================================================================
LOG_LEVEL=INFO
ENABLE_HTTPS=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
BCRYPT_COST=10

# ============================================================================
# Redis Cache Configuration (SECURED)
# ============================================================================

# Redis host (localhost ONLY for security)
REDIS_HOST=localhost

# Redis port (localhost binding only)
REDIS_PORT=6379

# Redis database number (always use db 0 for TheraGenome)
REDIS_DB=0

# CRITICAL: Redis authentication password
# SECURITY: This password MUST be set before deployment
# Generate secure password: openssl rand -hex 32
# NEVER use the same password as other services
# PRODUCTION: Use a strong, random 32-byte hex string
REDIS_PASSWORD=dev-password-change-in-production-openssl-rand-hex-32

# Redis connection timeouts (in seconds)
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5

# Enable automatic retry on timeout
REDIS_RETRY_ON_TIMEOUT=true

# Enable Redis caching (can be disabled for testing)
REDIS_CACHE_ENABLED=true

# TTL for cached items (configurable per item, defaults shown)
REDIS_CACHE_TTL_HOURS=24

# External APIs Configuration
GNOMAD_TIMEOUT=10
CLINVAR_DOWNLOAD_PATH=./data/clinvar
