# TheraGENOME Environment Configuration

# Application Settings
APP_NAME=theraGENOME API
APP_VERSION=1.0.0
ENVIRONMENT=development

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=genomic_db
DB_USER=postgres
DB_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@localhost:5432/genomic_db
TEST_DATABASE_URL=sqlite:///:memory:
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# JWT/Security Configuration
SECRET_KEY=your-secret-key-change-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS Configuration
CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8080", "http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=True

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW_VARIANTS=raw_variants

# Storage Configuration
STORAGE_PATH=./uploads
MAX_FILE_SIZE=5242880

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_HOURS=24

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=./logs

# External APIs Configuration
GNOMAD_TIMEOUT=10
CLINVAR_DOWNLOAD_PATH=./data/clinvar
ENABLE_DOCS=True
